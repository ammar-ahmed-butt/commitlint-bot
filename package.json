{
  "name": "commitlint-bot",
  "version": "2.0.0",
  "description": "GitHub App that enforces commit message, PR title, and branch naming standards",
  "main": "index.js",
  "scripts": {
    "start": "probot run ./index.js",
    "dev": "nodemon --exec 'probot run ./index.js'",
    "test": "node test/validate.test.js"
  },
  "keywords": [
    "github-app",
    "probot",
    "commitlint",
    "standards"
  ],
  "license": "MIT",
  "dependencies": {
    "probot": "^7.3.0"
  },
  "devDependencies": {
    "nodemon": "^1.18.4"
  },
  "engines": {
    "node": ">=8.3.0"
  }
}
